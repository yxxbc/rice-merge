# rice-merge live installer config
#
#   cp live/install.env.example live/install.env
#   chmod 600 live/install.env
#   $EDITOR live/install.env
#   bash live/install.sh --config live/install.env --dry-run
#   bash live/install.sh --config live/install.env
#
# Real hardware notes:
#   - UEFI only. The target disk is erased completely (GPT: 1G ESP + btrfs).
#   - Find the disk first:  lsblk -d -e 7,11 -o NAME,SIZE,MODEL
#     or:                   bash live/install.sh --list-disks
#     Use the WHOLE disk (/dev/nvme0n1, /dev/sda), never a partition.
#   - Wired network works out of the box. Wi-Fi: run `iwctl` before installing.
#   - The live console has no CJK glyphs, so the installer speaks English.
#
# Environment variables override values in this file.

# --- required ------------------------------------------------------------------
# Empty = prompt (only when stdin is a TTY). Never put a partition here.
DISK=
ALLOW_WIPE=yes            # double guard: anything other than yes refuses to partition

# --- account --------------------------------------------------------------------
SYS_HOSTNAME=arch
USERNAME=arch
USER_PASSWORD=CHANGE_ME   # required; placeholder is rejected
ROOT_PASSWORD=CHANGE_ME   # empty = lock root

# --- locale ---------------------------------------------------------------------
TIMEZONE=Asia/Shanghai
LOCALE=zh_CN.UTF-8
KEYMAP=us

# --- what to install ------------------------------------------------------------
# full  : base system + Minimal Niri + full rice visual layer (AUR heavy)
# smoke : dotfiles + 04n only, no package installation (fast merge validation)
# base  : base system only
PROFILE=full
# File manager for Minimal Niri: thunar (default) | gds | gds-portal
# Empty = ask on a TTY, otherwise thunar.
# gds is experimental: pinned GitHub package, x86_64 only, no matugen colors.
FILE_MANAGER=

# --- storage / boot -------------------------------------------------------------
ESP_SIZE=1G
SWAP=zram                 # zram | none
GRUB_REMOVABLE=0          # 1 only for VMs / removable disks (writes EFI/BOOT fallback)

# --- network --------------------------------------------------------------------
# Empty = use the ISO mirrorlist. China example:
# MIRROR_URL=https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch
MIRROR_URL=
SKIP_NET_CHECK=0

# --- sources --------------------------------------------------------------------
# Empty RICE_REPO = the repository this script lives in (9p share or local copy)
RICE_REPO=
RICE_REF=
LOWSPEC_REPO=https://github.com/okyashgajjar/Low-Spec-Niri-Dotfiles.git
LOWSPEC_REF=

# --- finish ---------------------------------------------------------------------
REBOOT=0                  # 1 = reboot when done
